{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*.php",
      "destination": "/app/:path*.html"
    },
    {
      "source": "/admin",
      "destination": "/admin__login.php.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
