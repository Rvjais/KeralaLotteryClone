{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/admin__login.php",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/admin__login.php.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/admin-login",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/admin-login.html",
      "destination": "/admin",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/:path*.php",
      "destination": "/app/:path*.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
