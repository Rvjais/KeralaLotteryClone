# Kerala Lottery Server & Database Configuration Template
PORT=3000

# MongoDB Connection String (MongoDB Atlas / Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kerala_lottery?retryWrites=true&w=majority

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT Authentication Secret
JWT_SECRET=your_secure_random_jwt_secret_key_here
